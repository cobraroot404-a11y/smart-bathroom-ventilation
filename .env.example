# Copy to .env and fill in real values. .env is git-ignored - never commit it.
# Used by docker-compose.yml and the automation service / simulator.

# --- MQTT broker (Eclipse Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_DEVICE_ID=bathroom-vent-01

# Separate credentials for the automation service vs. the device, so either
# can be rotated/revoked independently. See docs/security.md.
MQTT_AUTOMATION_USERNAME=bathroom-automation
MQTT_AUTOMATION_PASSWORD=CHANGE_ME_AUTOMATION_PASSWORD

MQTT_DEVICE_USERNAME=bathroom-vent-device
MQTT_DEVICE_PASSWORD=CHANGE_ME_DEVICE_PASSWORD

# Set to "true" only when the broker is reachable over TLS (required if
# MQTT traffic ever leaves a trusted local network). See docs/security.md.
MQTT_USE_TLS=false

# --- Energy report defaults (can be overridden via CLI flags) ---
ENERGY_FAN_WATTS=25.0
